{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app7",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "669b8afe-a711-44f2-9b8b-1d41a804e778","database_name": "web-app7" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b5a8af36b2c142b7ba989721c0c6504a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
